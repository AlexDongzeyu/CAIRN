# Allow-list: everything is ignored unless re-included below. The archive
# corpus, embeddings, intermediate artifacts and build output stay local.
/*

!/.gitignore
!/README.md

!/src/
!/experiments/
!/tests/
!/release/
!/data/

# Python
__pycache__/
*.pyc

# data/: only the small result files the paper's numbers are read from.
/data/*
!/data/results/
/data/results/e7_per_item_primary.json
/data/results/e_split_first.json
